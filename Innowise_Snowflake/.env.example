# ---------------------------------------------------------------------------
# Snowflake credentials.  Copy this file to `.env` and fill in the blanks:
#     cp .env.example .env
# `.env` is gitignored — .env.example is the only one that gets committed, so
# never put a real secret in this file.
#
# Both the local test script and docker compose read `.env`, so the values are
# entered exactly once and every component sees the same account.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------

# Account identifier, NOT the full URL.  Find it in Snowsight under the account
# selector at the bottom-left -> hover your account -> "Copy account identifier",
# then swap the dot for a hyphen:  myorg.my_account  ->  myorg-my_account
# If your URL is https://abcd-xy12345.snowflakecomputing.com, use abcd-xy12345
SNOWFLAKE_ACCOUNT=

# Your login name (the user, not the e-mail address, unless they are the same).
SNOWFLAKE_USER=

# --- Authentication: pick exactly ONE of the two blocks below --------------

# (a) Key-pair auth — the recommended option.  Snowflake blocks password-only
#     sign-ins for human users, so a password alone may simply be rejected.
#     Generate a key pair and register the public half (see README):
#       openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out secrets/snowflake_key.p8 -nocrypt
#     Path is relative to this directory; the container sees the same file at
#     /opt/airflow/secrets/ and the compose file rewrites the path for you.
SNOWFLAKE_PRIVATE_KEY_PATH=
# Leave empty if you generated the key with -nocrypt (no passphrase).
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# (b) Password auth — fine for a service user or a trial account that still
#     allows it.  Leave blank if you are using the key pair above.
SNOWFLAKE_PASSWORD=

# (c) Programmatic Access Token (PAT) — a token Snowflake issues for a user,
#     used *in place of* a password.  Works identically in the local script and
#     in Airflow, which makes it the simplest token option.  Create one in
#     Snowsight (user -> Settings -> Authentication -> Programmatic access
#     tokens) or with:
#       ALTER USER your_user ADD PROGRAMMATIC ACCESS TOKEN airflow_token;
#     Leave SNOWFLAKE_AUTHENTICATOR below at "snowflake": a PAT substitutes for
#     the password, so it travels the ordinary password path.  Do NOT set the
#     authenticator to PROGRAMMATIC_ACCESS_TOKEN — that selects a different
#     server-side flow and is rejected with "token is invalid".
SNOWFLAKE_PAT=

# (d) A single, already-minted OAuth access token.  Local script ONLY — the
#     Airflow provider has no field for a static token, and these expire in
#     minutes, so they suit a one-off check rather than a scheduled DAG.
#     For OAuth in Airflow use a refresh token instead (see README).
SNOWFLAKE_OAUTH_TOKEN=

# --- Authenticator --------------------------------------------------------
# Must match the block you filled in above.  An empty value is NOT the same as
# the default here: it makes the connector attempt an SSO/browser handshake.
#   snowflake        -> password, key pair AND PAT (blocks a, b and c)
#   oauth            -> OAuth access token (block d)
#   externalbrowser  -> interactive SSO, cannot work inside Airflow
SNOWFLAKE_AUTHENTICATOR=snowflake

# --- Session context ------------------------------------------------------
# Every one of these can be left blank; Snowflake then falls back to whatever
# default the user has.  Setting them explicitly makes runs reproducible.

SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=PUBLIC

# --- Airflow --------------------------------------------------------------
# On Linux, matches file ownership on the mounted logs/ directory to your host
# user.  `id -u` is 1000 for the first user on most systems.
AIRFLOW_UID=1000
